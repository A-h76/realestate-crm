    "date-fns-tz": "^3.2.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "prisma": "^6.19.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
