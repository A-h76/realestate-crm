# Synas Labs Lead-to-Sale CRM — environment template
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leadtosale_crm?schema=public"
# At least 32 random bytes, unique per environment: `openssl rand -base64 32`
AUTH_SECRET="generate-a-secure-secret-at-least-32-characters"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Fail closed unless explicitly enabled. Production must leave this unset or "false".
DEMO_MODE="false"

# Required only when DEMO_MODE=true and running db:seed / demo reset.
# DEMO_SEED_PASSWORD=
# Optional: separate password for the UX audit demo users (defaults to DEMO_SEED_PASSWORD)
# UX_AUDIT_PASSWORD=

# Optional distributed rate limiter. If unset, PostgreSQL RateLimitBucket is used.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional AI provider (deterministic fallbacks are used when unset). Server-only: never NEXT_PUBLIC_.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# "true" selects the live Meta WhatsApp Cloud API and needs WHATSAPP_ACCESS_TOKEN + WHATSAPP_PHONE_NUMBER_ID, or every send is
# recorded as Failed. Anything else uses the demo provider only in DEMO_MODE=true or a non-production process; in production
# without DEMO_MODE, sends are recorded as Failed ("not connected"). Receiving also needs WHATSAPP_APP_SECRET + WHATSAPP_VERIFY_TOKEN.
WHATSAPP_BUSINESS_ENABLED="false"
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_WORKSPACE_ID=
# Meta Graph API version the Cloud API calls target. Defaults to v21.0 if unset.
# WHATSAPP_GRAPH_API_VERSION=

# --- Security / deployment switches ---
# "true" turns off the Strict-Transport-Security header. Only for an https-less test host; leave unset in production
# (startup logs a warning if it is on in a production build).
# DISABLE_HSTS=

# --- Tooling only (never needed by the running app) ---
# scripts/perf-http.ts: "true" makes `next start` expose x-perf-summary response headers; the harness sets it itself.
# Do not enable on a public deployment: it adds timing headers to API responses.
# PERF_HTTP_HEADERS=
# PERF_HTTP_URL=http://127.0.0.1:3010   # measure an already-running server instead of starting one
# PERF_HTTP_PORT=3010
# scripts/e2e-*.ts and scripts/check-csp.ts sign in with these. Use a throwaway local/staging user, never a real account.
# BASE_URL=http://localhost:3000
# E2E_EMAIL=
# E2E_PASSWORD=
# CHROME_PATH=   # browser for scripts/check-csp.ts if it is not found automatically

# The app validates its configuration at start-up (src/lib/env.ts): a production process refuses to start with a
# missing DATABASE_URL / AUTH_URL, or an AUTH_SECRET that is shorter than 32 characters or still a placeholder.
# Other problems (half-configured WhatsApp / Upstash, DEMO_MODE in production) are logged as warnings.
